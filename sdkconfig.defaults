# --- 新增：LVGL 日志配置 (从 reminder 引入) ---
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# --- GIF 流畅度优化：LVGL POSIX 文件系统读缓存 ---
# 根因：GIF 每帧解码会打一连串零碎的小块 flash 读(GIFGetMoreData)，
#   而外挂 flash 是 SPI3 单线 20MHz 慢速读。CACHE_SIZE=0 时这些读全部直通无缓存，
#   说话(CPU0 音频解码争用)/监听(CPU1 AEC 抢 PSRAM 总线)时累计延迟超过帧间隔 → 掉帧。
# 开启 4096 字节滑动窗口预读(与 fatfs allocation_unit_size=4096 对齐)，
#   把零碎顺序读合并成块读，flash 事务数下降一个数量级。只开 1 个 GIF 文件，故只多占 1 份缓存。
CONFIG_LV_FS_POSIX_CACHE_SIZE=4096

# --- 基础硬件配置 ---
# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.4 Project Minimal Configuration
#

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SR_MN_CN_MULTINET6_QUANT=y
CONFIG_SR_MN_EN_MULTINET6_QUANT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- 关键：PSRAM 与 DMA 支持配置 (修复 LCD 报错) ---
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_BLUFI_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_MALLOC_CAP_DEFAULT=y
# 允许数据缓存，这是 SPI DMA 访问 PSRAM 的前提条件之一
CONFIG_SPIRAM_ALLOW_BCACHE=y

# --- 性能与调试 ---
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# --- 强制将 WiFi 和 LwIP 相关的内存分配到 PSRAM ---
CONFIG_LWIP_DEFAULT_TCP_RECVMBOX_IN_PSRAM=y

# --- 顺手把 mbedTLS (MQTT/WebSocket 加密握手) 的内存也挪出去 ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_TCP_MSS=536
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- 【临时调试】定位随机堆损坏：LIGHT 毒化，free 时对越界块报 CORRUPT HEAP ---
#     用 LIGHT 而非 COMPREHENSIVE：本设备内部 SRAM 紧张，COMPREHENSIVE 开销会压爆
#     WiFi esf_buf 造成开机伪故障。定位完成后删除本行。
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_MBEDTLS_DHM_C=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=83
CONFIG_LV_FS_POSIX_PATH="/S"
CONFIG_LV_USE_GIF=y

#FreeRTOS 定时器服务任务的堆栈大小，默认2048字节
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
